{
  "name": "visual-shahnameh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup": "pnpm install --frozen-lockfile && python3 -m venv .venv && .venv/bin/pip install -q pillow",
    "status": "node scripts/next_sections.mjs",
    "check:chapters": "node scripts/check_chapters.mjs",
    "text:build": ".venv/bin/python -I scripts/build_text.py text/shahnameh-ferdowsi.pdf text/ && python3 -I scripts/build_toc.py text/shahnameh.json src/content/toc.json && node scripts/update_readme_contents.mjs && node scripts/check_chapters.mjs",
    "check": "node scripts/check_section.mjs",
    "art:convert": ".venv/bin/python -I scripts/optimize_art.py",
    "art:upload": "node scripts/art_upload.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "cf": "1.0.0-beta.27",
    "playwright-core": "1.58.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0"
  },
  "packageManager": "pnpm@12.16.1"
}
